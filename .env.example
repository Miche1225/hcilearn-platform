PORT=3000
JWT_SECRET=change_this_to_a_long_random_string
NODE_ENV=development

# Postgres connection string from Supabase or Neon (Settings > Database > Connection string)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# From cloudinary.com dashboard (free account) - used for profile photo uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
