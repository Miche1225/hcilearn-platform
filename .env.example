PORT=3000
JWT_SECRET=change_this_to_a_long_random_string
NODE_ENV=development

# Postgres connection string from Supabase or Neon (Settings > Database > Connection string)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# From cloudinary.com dashboard (free account) - used for profile photo uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- EMAIL NOTIFICATIONS (signup, login, forgot password) ----------
# Public URL of your site. Used to build the link inside the "reset password" email.
# Local:      http://localhost:3000
# Production: https://your-app.onrender.com   (no trailing slash needed)
APP_URL=http://localhost:3000

# OPTION A - Gmail SMTP (works locally and on paid hosts).
# EMAIL_PASS must be a Gmail "App Password" (Google Account > Security >
# 2-Step Verification > App passwords), NOT your normal Gmail password.
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# OPTION B - Brevo HTTPS API (REQUIRED on Render FREE, which blocks SMTP ports).
# Free key at brevo.com > SMTP & API > API Keys. EMAIL_FROM must be a sender
# you verified in Brevo (Senders & IP > Senders). If BREVO_API_KEY is set it is
# used instead of Gmail SMTP.
# BREVO_API_KEY=
# EMAIL_FROM=yourgmail@gmail.com

