PORT=3000
NODE_ENV=production

# Long random secret that signs login cookies (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Postgres connection string from Supabase or Neon (Settings > Database > Connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# From cloudinary.com dashboard (free account) - used for profile photo uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret


# ---------- EMAIL NOTIFICATIONS (signup, login, forgot password) ----------
# Public URL of your site. Used to build the link inside the "reset password" email.
# REQUIRED in production.
# Local:      http://localhost:3000
# Production: https://your-app.onrender.com   (no trailing slash needed)
APP_URL=https://your-app.onrender.com

# OPTION A - Gmail SMTP (works locally and on paid hosts).
# EMAIL_PASS must be a Gmail "App Password" (Google Account > Security >
# 2-Step Verification > App passwords), NOT your normal Gmail password.
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your-16-letter-app-password

# OPTION B - Brevo HTTPS API (REQUIRED on Render FREE, which blocks SMTP ports).
# Free key at brevo.com > SMTP & API > API Keys. EMAIL_FROM must be a sender
# you verified in Brevo (Senders & IP > Senders). If BREVO_API_KEY is set it is
# used instead of Gmail SMTP.
# BREVO_API_KEY=
# EMAIL_FROM=yourgmail@gmail.com

# Secret key used to HMAC email addresses (at least 32 characters).
# Keep it the same once users exist, or they can no longer log in by email.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_HASH_SECRET=replace-with-a-long-random-secret

# NEVER put real secrets in this file - it is committed to GitHub.
# Real values go in .env (ignored by git) and in Render's Environment settings.
